# ===================
# Base directory: ignore everything, then allowlist only what we commit.
# New loose files dropped at the repo root are ignored by default.
# (Rules further down still apply *within* the re-included directories.)
# ===================
/*
!/.gitignore
!/.env.example
!/LICENSE
!/README.md
!/build.js
!/package.json
!/package-lock.json
# Tracked top-level directories
!/.claude/
!/database/
!/mobile/
!/pipeline/
!/scripts/
!/src/

# Environment variables
.env
.env.local
.env.*.local

# Claude Code and IDE
.claude/*
!.claude/commands/
.claude/commands/*
!.claude/commands/add-locations.md
!.claude/commands/add-websites.md
!.claude/commands/dedupe-events.md
!.claude/commands/discover-venues.md
!.claude/commands/fix-undated-events.md
!.claude/commands/fix-unmapped-events.md
!.claude/commands/run-pipeline.md
.vscode/
CLAUDE.md

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Node modules
node_modules/

# Virtual environments
venv/
env/
ENV/

# Build output
dist/

# Frontend data — only static config is tracked; events/locations/etc. are generated
src/data/*
!src/data/map-style-dark.json
!src/data/map-style-light.json
!src/data/tags.json
!src/data/tag_hierarchy.json

# Scraper dumps (raw payloads, regenerable)
/data/

# Scripts directory — only the four canonical helpers are tracked
scripts/*
!scripts/add_locations.php
!scripts/add_websites.php
!scripts/upload_public_html.py
!scripts/geocode.php

# PHP config with database credentials
src/api/config.php

# SSH private keys
*.pem

# Database backups
database/backups/

# Screenshots and images
screenshots/
*.png
*.jpeg
.playwright-mcp/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# FTP credentials backup
.ftpconfig

# ===================
# iOS / Xcode
# ===================

# Build generated
mobile/ios/**/build/
mobile/ios/**/DerivedData/

# Xcode user-specific files
*.xcuserstate
*.xcuserdatad/
xcuserdata/

# Xcode workspaces (auto-generated)
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

# CocoaPods
mobile/ios/**/Pods/
mobile/ios/**/Podfile.lock

# Carthage
mobile/ios/**/Carthage/Build/
mobile/ios/**/Carthage/Checkouts/

# Swift Package Manager
mobile/ios/**/.build/
mobile/ios/**/Package.resolved

# fastlane
mobile/ios/**/fastlane/report.xml
mobile/ios/**/fastlane/Preview.html
mobile/ios/**/fastlane/screenshots/
mobile/ios/**/fastlane/test_output/

# Code coverage
*.gcno
*.gcda

# Playgrounds
timeline.xctimeline
playground.xcworkspace

# Archives
*.xcarchive

# ===================
# Android
# ===================

# Gradle
mobile/android/.gradle/
mobile/android/**/build/
!mobile/android/gradle/wrapper/gradle-wrapper.jar

# Local configuration (contains SDK path)
mobile/android/local.properties

# Android Studio / IntelliJ IDEA
mobile/android/.idea/caches/
mobile/android/.idea/libraries/
mobile/android/.idea/modules.xml
mobile/android/.idea/workspace.xml
mobile/android/.idea/navEditor.xml
mobile/android/.idea/assetWizardSettings.xml
mobile/android/.idea/*.iml
*.iml

# Keystore files (signing credentials)
mobile/android/*.jks
mobile/android/*.keystore
mobile/android/keystore.properties

# APK/AAB outputs
*.apk
*.aab

# NDK
mobile/android/**/obj/
mobile/android/**/.cxx/

# Proguard
mobile/android/**/proguard/

# Lint
mobile/android/**/lint-results*

# Android profiling
*.hprof
