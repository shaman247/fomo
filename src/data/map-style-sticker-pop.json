      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": {
        "fill-color": "#fbf3e6"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": {
        "fill-color": "transparent"
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": [
        "any",
        [
          "==",
          "kind",
          "park"
        ],
        [
          "==",
          "kind",
          "forest"
        ]
      ],
      "paint": {
        "fill-color": "#c8ecc0"
      }
    },
    {
      "id": "landuse-cemetery",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": [
        "any",
        [
          "==",
          "kind",
          "cemetery"
        ],
        [
          "==",
          "kind",
          "golf_course"
        ]
      ],
      "paint": {
        "fill-color": "#bfe4b6"
      }
    },
    {
      "id": "landuse-beach",
