      "minzoom": 12,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Inter Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
