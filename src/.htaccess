# Vanity route: /feedback opens the app with the Submit Feedback modal.
# FeedbackManager sees the #feedback hash, opens the modal, and replaceState()s
# the address bar back to the bare domain (same cleanup share links get).
# NE keeps the '#' literal in the Location header; QSD drops any query string
# (otherwise it would be appended after the fragment, corrupting the hash).
# Target is domain-root absolute — matches the production deployment.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^feedback/?$ /#feedback [NC,NE,QSD,R=302,L]
</IfModule>

# MIME type fixes
# LiteSpeed compresses text/* by default but not application/json or binary types.
# Remap JSON to text/json so it gets compressed automatically.
AddType text/json .json

# Google Play app-link verification requires Content-Type: application/json on
# /.well-known/assetlinks.json — exempt it from the text/json remap above.
<Files "assetlinks.json">
    ForceType application/json
</Files>

# Apache fallback: enable gzip compression for text-based assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/json
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/javascript
    # Servers disagree on the .js MIME type (Apache/XAMPP: application/x-javascript;
    # others: text/javascript). List every variant or the app bundle + maplibre-gl.js
    # ship UNCOMPRESSED (~1 MB for maplibre vs ~250 KB gzipped — a big slow-link regression).
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    # Content-hashed bundles: cache for 1 year (hash changes on content change)
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    # Data files: cache for 1 hour (updated by pipeline)
    ExpiresByType text/json "access plus 1 hour"
    ExpiresByType application/json "access plus 1 hour"
    # Fonts: cache for 1 year
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    # HTML: no cache (always serve fresh)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Service worker: MUST never be long-cached — the 1-year JS rule above would
# freeze SW updates (including the kill-switch rescue) on proxies. Browsers
# default to bypassing the HTTP cache for SW scripts, but don't rely on it.
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, must-revalidate"
    </IfModule>
</Files>
